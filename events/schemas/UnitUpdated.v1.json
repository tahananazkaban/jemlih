{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UnitUpdated.v1.json",
  "title": "UnitUpdated v1",
  "description": "An Owner changed a Unit's details or prices; carries the full new state. Published by fleet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "model", "plate_number", "year", "transmission", "daily_price", "hourly_price", "security_deposit"],
  "properties": {
    "unit_id": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "plate_number": { "type": "string", "minLength": 1 },
    "year": { "type": "integer" },
    "transmission": { "enum": ["automatic", "manual"] },
    "daily_price": { "type": "integer", "minimum": 1, "description": "Rupiah." },
    "hourly_price": { "type": "integer", "minimum": 1, "description": "Rupiah." },
    "security_deposit": { "type": "integer", "minimum": 0, "description": "Rupiah." }
  }
}
