{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.v1.json",
  "title": "Event envelope",
  "description": "Wrapper around every event published to the jemlih bus; the event payload is in data.",
  "type": "object",
  "required": ["event_id", "type", "version", "occurred_at", "rental_id", "source", "data"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "description": "Unique per event; consumers deduplicate on it." },
    "type": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "rental_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "pattern": "^jemlih\\.[a-z]+$" },
    "data": { "type": "object" }
  }
}
