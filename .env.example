# Local defaults. Copy to .env only to override them; make, compose and the tests read it.

# Host ports
FLOCI_PORT=4566
FLEET_PORT=8081
ACCOUNT_PORT=8082
BOOKING_PORT=8083

# The emulator accepts any non-empty credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Endpoint used by tests and tools running on the host; follows FLOCI_PORT when unset
# JEMLIH_AWS_ENDPOINT=http://localhost:4566

# The single Rental that self-registered Renters join and seed-owner creates the Owner in
RENTAL_ID=default

# fleet
FLEET_TABLE=jemlih-fleet

# booking; tests reach fleet on the host port
BOOKING_TABLE=jemlih-booking
BOOKING_HOLD=2h
# FLEET_URL=http://localhost:8081

# Cognito settings come from OpenTofu outputs at `make up` and `make test`; do not set them here
