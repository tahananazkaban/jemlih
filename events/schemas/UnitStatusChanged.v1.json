{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UnitStatusChanged.v1.json",
  "title": "UnitStatusChanged v1",
  "description": "A Unit moved between available, maintenance and retired. Published by fleet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "from", "to"],
  "properties": {
    "unit_id": { "type": "string", "minLength": 1 },
    "from": { "enum": ["available", "maintenance", "retired"] },
    "to": { "enum": ["available", "maintenance", "retired"] }
  }
}
