# Local defaults. Copy to .env only to override them; every value already has this default.

# Host ports
FLOCI_PORT=4566
FLEET_PORT=8081

# The emulator accepts any non-empty credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Endpoint used by tests and tools running on the host
JEMLIH_AWS_ENDPOINT=http://localhost:4566

# fleet
FLEET_TABLE=jemlih-fleet
RENTAL_ID=default
